# Automation env. Copy to automation/.env on the VPS, fill in.

# Apify (discovery loop)
LW_APIFY_TOKEN=                    # apify_api_xxx — Apify console > Settings > Integrations
LW_DISCOVERY_SEEDS=                # comma-separated @handles of large in-niche accounts to pull followers from
LW_DISCOVERY_KEYWORDS=             # comma-separated niche keywords for the reply-target search

# late.dev (content loop)
LW_LATE_API_KEY=                   # from late.dev dashboard
LW_LATE_TWITTER_PROFILE_ID=        # the X/Twitter profile ID in late.dev

# Shared with the bot
LW_CLAUDE_KEY=
LW_CLAUDE_MODEL=claude-sonnet-4-6
LW_PERSONA_PATH=personas/persona-one.yaml
