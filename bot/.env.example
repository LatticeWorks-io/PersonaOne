# LatticeWorks bot env. Copy to .env and fill in.

# Telegram
LW_BOT_TOKEN=                  # from @BotFather (Page 08 card 74)
LW_OPERATOR_USER_ID=           # your Telegram numeric user ID for /admin commands

# Claude
LW_CLAUDE_KEY=                 # sk-ant-... from Anthropic console (Page 06 card 53)
LW_CLAUDE_MODEL=claude-sonnet-4-6

# NowPayments (optional in v0 — bot falls back to Stars-only if absent)
LW_NOWPAYMENTS_API_KEY=        # from NowPayments dashboard (Page 07)
LW_NOWPAYMENTS_IPN_SECRET=     # IPN HMAC secret (set in NowPayments settings)
LW_NOWPAYMENTS_WEBHOOK_HOST=   # public URL of this VPS, e.g. https://bot.latticeworks.io

# Persona
LW_PERSONA_PATH=personas/persona-one.yaml

# Storage
LW_DB_PATH=bot/data/bot.db
